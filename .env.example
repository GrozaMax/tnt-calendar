# Скопируйте в .env и подставьте свои значения. Не коммитьте .env.

# Токен бота от @BotFather (храните только в .env на сервере)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# База данных
DATABASE_URL=sqlite+aiosqlite:///./crossfit_hub.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/crossfit_hub

# Telegram ID супер-админов через запятую (без кавычек)
ADMIN_TELEGRAM_IDS=123456789

# Веб-панель: общий секрет для входа тренеров и админов (длинная случайная строка)
WEB_LOGIN_SECRET=change_me_to_a_long_random_secret

# Опционально: ключ для подписи сессий/токенов веба
# WEB_SECRET_KEY=

# Логи: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Веб-сервер (опционально)
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# WEB_DEBUG=true

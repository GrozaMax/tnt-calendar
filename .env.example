# Скопируйте в .env на сервере. Файл .env не коммитить.

# --- Telegram / бот ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- База данных ---
# Локально:
DATABASE_URL=sqlite+aiosqlite:///./crossfit_hub.db
# Docker (общий путь на volume для bot + web):
# DATABASE_URL=sqlite+aiosqlite:////app/data/crossfit_hub.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Супер-админы (Telegram ID через запятую)
ADMIN_TELEGRAM_IDS=123456789

# --- Веб-панель ---
# Общий секрет входа, если у пользователя не задан индивидуальный пароль (см. вкладка «Пользователи»)
WEB_LOGIN_SECRET=change_me_to_a_long_random_secret

# Режим отладки: true только для разработки (пустой WEB_LOGIN_SECRET допустим с предупреждением в лог)
WEB_DEBUG=false

WEB_HOST=0.0.0.0
WEB_PORT=8000
# Часто на PaaS задают только PORT
# PORT=8000

# Ключ для будущей подписи сессий/JWT (рекомендуется задать в production)
WEB_SECRET_KEY=

# Опционально: предопределённые токены через запятую (сейчас основной поток — Bearer из /api/auth/login)
# WEB_ADMIN_TOKENS=

# Каталог загрузок (картинка расписания); в Docker тот же путь в обоих контейнерах
# UPLOADS_DIR=/app/data/uploads

# --- Прочее ---
LOG_LEVEL=INFO
